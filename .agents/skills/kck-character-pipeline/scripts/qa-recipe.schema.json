{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCK internal candidate sequence QA recipe (not 03C delivery)",
  "type": "object", "additionalProperties": false,
  "required": ["format", "canvas", "target_anchor", "scale", "resampling", "loop", "frames"],
  "properties": {
    "format": {"const": "kck-qa-recipe-v1"},
    "canvas": {"$ref": "#/$defs/canvas"},
    "target_anchor": {"$ref": "#/$defs/point"},
    "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
    "resampling": {"enum": ["NEAREST", "LANCZOS"]},
    "loop": {"type": "integer", "enum": [0, 1]},
    "frames": {"type": "array", "minItems": 2, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "sha256", "anchor", "duration_ms"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "anchor": {"$ref": "#/$defs/point"},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }}
  },
  "$defs": {
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
    "canvas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 4096}}
  }
}
